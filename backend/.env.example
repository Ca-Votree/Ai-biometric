# === Application Settings ===
APP_NAME="AI Biometrics Attendance System"
APP_ENV=development
DEBUG=true
# SECRET_KEY must be a unique random value in production.
SECRET_KEY=
ADMIN_ID=admin
ADMIN_PASSWORD=

# === Server ===
HOST=0.0.0.0
PORT=8000

# === Database ===
DATABASE_URL=sqlite+aiosqlite:///./data/attendance.db
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/attendance

# === AI Model Settings ===
DETECTION_MODEL=buffalo_l
FACE_DETECTION_THRESHOLD=0.5
FACE_RECOGNITION_THRESHOLD=0.45
MAX_FACES_PER_FRAME=50

# === Camera Settings ===
CAMERA_SOURCE=0
# CAMERA_SOURCE=rtsp://username:password@ip:port/stream
FRAME_WIDTH=1280
FRAME_HEIGHT=720
FPS=15

# === FAISS Settings ===
FAISS_INDEX_PATH=./data/faiss_index/face_index.bin
FAISS_ID_MAP_PATH=./data/faiss_index/id_map.json

# === Logging ===
LOG_LEVEL=INFO
LOG_FILE=./data/logs/app.log
